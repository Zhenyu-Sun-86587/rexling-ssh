  "validation": {
    "jvm_passed": 88,
    "optional_benchmark_skipped_in_normal_suite": 1,
    "emulator_ui_passed": 82,
    "isolated_host_benchmark_runs": 5,
    "checks": [
      "Wrapped prefixes split across cells/rows, uppercase schemes, hidden/gapped text, OSC 8 labels and stored destinations",
      "Preview identity reuse, leaving-pane snapshot precedence, unchanged original maps and sixteen-frame insertion-order eviction",
      "GPU interior-pixel comparison of old group fade and scrim over overlapping text/backgrounds in light/dark",
      "Existing selection, links, mouse, keyboard, font, hardware-row, pane and header checks",
      "Debug/release builds, release lint, signed non-debuggable release, ART profiles and 16 KiB alignment"
    ],
    "not_rerun": "Separate live MultiServer/ActivityAttention emulator fixtures; native and transport code unchanged"
  },
  "methodology": {
    "variants": "Same timing/motion instrumentation in every release; baseline, each single optimization, combined, repeated baseline and repeated combined",
    "workload": "Same disposable two-pane 23-row colored repaint up to 30 Hz, including one ordinary URL and one OSC 8 label row, four pane swipes, output restart and vertical drag",
    "warmup": "Five seconds of untraced output after each installation, followed by a 20-second low-overhead FrameTimeline/app-marker trace",
    "gesture_phase": "Frames overlapping positive Rexlink.paneMotion counter intervals; four positive intervals per trace",
    "host_allocations": "ThreadMXBean thread-allocated bytes with precreated alternating changed 30x80 linkless frames (2000 calls) and an unchanged sixteen-entry preview cache (100000 calls), after 300 warm-up calls. Includes test-loop overhead, about 16 bytes/call in the optimized cache case.",
    "limits": [
      "Short sequential stress runs, not randomized trials or normal typing",
      "Host timings varied between fresh JVMs; allocation counts are the primary host result, not phone latency",
      "Link-index work is nested inside terminal draw; durations cannot be added",
      "FrameTimeline/GFX windows and flags differ; flags overlap",
      "No new native-publication/key-to-pixel, GPU memory or battery measurement",
      "All traces have no reported data-loss/error/overwrite counters"
    ]
  },
  "results": {
    "repeatable": "Link index mean about 1.31\u20131.32 ms baseline versus 0.76\u20130.78 ms with prefix precheck; terminal draw mean 3.14\u20133.26 ms baseline versus 2.72\u20132.80 ms combined",
    "preview_cache": "Phone cache-section mean about 0.058\u20130.060 ms baseline versus 0.033\u20130.037 ms optimized; host cache allocation about 875 to 16 bytes/call including loop overhead",
    "link_allocation": "About 121 KB to 6 KB per changed linkless screen in the host workload (~95% reduction)",
    "swipe_limit": "No reliable isolated swipe-time improvement established; scrim retained as visually compatible avoidance of group-alpha compositing, with no measured power/memory claim",
    "whole_frame_limit": "No substantial repeatable overall jank improvement established. Combined whole-frame means 12.53/13.33 ms versus baseline 13.14/13.35 ms; gesture p95 varied. Expected frame budget remains 8.33 ms; no refresh-rate policy changed."
  },

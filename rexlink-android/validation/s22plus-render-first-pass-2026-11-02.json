{
  "date": "2026-11-02",
  "device": "Samsung Galaxy S22+ SM-S906E, Android 16",
  "changes": {
    "links": "Allocation-free prefix scan over logical wrapped text before building inferred-link character positions; OSC 8 labels still processed independently",
    "previews": "Reuse existing bounded preview map when there are no previews and no leaving frame to remember; insertion/eviction semantics preserved",
    "swipe": "Draw a backdrop scrim over opaque cards instead of using group alpha; original fade matched for overlapping interior content in dark and light GPU pixel checks"
  },
  "commits": {
    "links": "a6b3c65",
    "previews": "fcea24f",
    "swipe": "c4cdcc8",
